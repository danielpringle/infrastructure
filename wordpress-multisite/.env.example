# Project
PROJECT_NAME=multisite
DOMAIN=multisite.local
WP_LOCALE=en_GB
WP_TIMEZONE=Europe/London

# WordPress
WP_TITLE="Multisite"
WP_MULTISITE=1
WP_MULTISITE_SUBDOMAINS=1
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.test

# Database
DB_NAME=multisite
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Local mail configuration.
MAIL_HOST=mailpit
MAILPIT_PORT=8026
MAILPIT_SMTP_PORT=1026
MAIL_FROM=no-reply@demo.test
MAIL_FROM_NAME="multisite"

# PHP My Admin
PHPMYADMIN_PORT=8181

DEV_PLUGINS="config/dev-plugins.txt"